{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project . tts-hook-startup",
            "timeout": 60,
            "statusMessage": "Checking Kokoro TTS"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project . tts-hook-stop",
            "timeout": 60,
            "statusMessage": "Speaking final response"
          }
        ]
      }
    ]
  }
}
