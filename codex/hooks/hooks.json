{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from 'git+https://github.com/patricka3125/tts-hook.git@main' tts-hook-startup",
            "timeout": 60,
            "statusMessage": "Checking Kokoro TTS"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from 'git+https://github.com/patricka3125/tts-hook.git@main' tts-hook-stop",
            "timeout": 60,
            "statusMessage": "Speaking final response"
          }
        ]
      }
    ]
  }
}
